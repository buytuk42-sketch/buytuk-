# ---------------------------------------------------------------------------
# BuyTuk flagship — environment template. Copy to `.env.local` and fill in.
# Nothing in this file is exposed to the browser except the NEXT_PUBLIC_ keys.
# ---------------------------------------------------------------------------

# Public site origin — used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=https://buytuk.com

# ---- Headless CMS (brief §17) ---------------------------------------------
# Leave CMS_ENDPOINT empty to run entirely from the committed JSON in
# /content/cms. Set it to switch every content type to the live CMS at once.
CMS_ENDPOINT=
CMS_READ_TOKEN=
CMS_REVALIDATE_SECONDS=300

# ---- Contact endpoint (brief §16) -----------------------------------------
# CONTACT_PROVIDER=resend enables real delivery. Without it, valid submissions
# return HTTP 503; the form never reports an enquiry as received unless sent.
CONTACT_PROVIDER=
RESEND_API_KEY=
CONTACT_INBOX=Buytuk1@gmail.com
CONTACT_FROM="BuyTuk <no-reply@buytuk.com>"
CONTACT_RATE_WINDOW_MS=60000
CONTACT_RATE_MAX=5

# ---- Analytics (brief §18) ------------------------------------------------
# Consent-gated, privacy-first. Without an endpoint, all events are dropped.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
